-        self.input_article_title(title)
-        self.input_rich_text_content(content)
-        self.publish()
-
-    def publish_micro_header(self, content: str):
-        """发布微头条的便捷方法。"""
-        self.open_publish_page()
-        self.switch_to_micro_header()
-        self.input_micro_header(content)
-        self.publish()
